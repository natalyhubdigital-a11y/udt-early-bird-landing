{
  "rewrites": [
    { "source": "/espana", "destination": "/espana.html" },
    { "source": "/alemania", "destination": "/alemania.html" },
    { "source": "/canada", "destination": "/canada.html" },
    { "source": "/inglaterra", "destination": "/inglaterra.html" },
    { "source": "/perfil", "destination": "/perfil.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(assets|css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
